{
  "techniques": [
    {
      "technique_id": "T1059.001",
      "name": "PowerShell",
      "tactic": "Execution",
      "conditions": {
        "event_types": ["process_creation"],
        "object_contains": ["powershell.exe", "pwsh.exe", "powershell"]
      }
    },
    {
      "technique_id": "T1059.003",
      "name": "Windows Command Shell",
      "tactic": "Execution",
      "conditions": {
        "event_types": ["process_creation"],
        "object_contains": ["cmd.exe"]
      }
    },
    {
      "technique_id": "T1041",
      "name": "Exfiltration Over C2 Channel",
      "tactic": "Exfiltration",
      "conditions": {
        "event_types": ["network_connection"],
        "external_dst_ip": true
      }
    },
    {
      "technique_id": "T1547.001",
      "name": "Registry Run Keys / Startup Folder",
      "tactic": "Persistence",
      "conditions": {
        "event_types": ["registry_write"],
        "object_contains": ["currentversion\\run", "currentversion\\runonce", "startup"]
      }
    },
    {
      "technique_id": "T1033",
      "name": "System Owner/User Discovery",
      "tactic": "Discovery",
      "conditions": {
