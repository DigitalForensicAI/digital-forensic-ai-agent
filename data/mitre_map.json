      }
    },
    {
      "technique_id": "T1083",
      "name": "File and Directory Discovery",
      "tactic": "Discovery",
      "conditions": {
        "command_contains": ["dir /s", "ls -la", "get-childitem", "tree /f"]
      }
    },
    {
      "technique_id": "T1057",
      "name": "Process Discovery",
      "tactic": "Discovery",
      "conditions": {
        "command_contains": ["tasklist", "ps -ef", "ps aux", "get-process"]
